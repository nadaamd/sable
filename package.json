{
  "name": "sable",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sable \u2014 the confidential cross for autonomous agents. A sealed-bid batch auction on COTI gcEVM.",
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'test/*.test.ts'",
    "test:contracts": "hardhat test test/contracts/*.test.ts --network hardhat",
    "compile": "hardhat compile",
    "spike": "hardhat run scripts/spike-gas.ts --network coti-testnet",
    "e2e": "hardhat run scripts/cross-e2e.ts --network coti-testnet",
    "agents": "hardhat run scripts/run-agents.ts --network coti-testnet",
    "check": "ts-node scripts/agents/check-offline.ts",
    "frontend:config": "ts-node scripts/frontend-config.ts",
    "stress": "hardhat run scripts/stress-max-orders.ts --network coti-testnet",
    "rescue": "hardhat run scripts/test-rescue.ts --network coti-testnet",
    "uniformity": "hardhat run scripts/gas-uniformity.ts --network coti-testnet",
    "wallet": "hardhat run scripts/new-wallet.ts --network coti-testnet",
    "preflight": "ts-node scripts/preflight.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.20.1",
    "hardhat": "^2.22.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@coti-io/coti-contracts": "^1.0.9",
    "@coti-io/coti-ethers": "^1.0.5",
    "dotenv": "^16.4.5"
  }
}
